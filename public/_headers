# Cabeceras de seguridad (Netlify y Cloudflare Pages las leen de este archivo).
# La política CSP empieza en modo "solo reporta": no bloquea nada, pero muestra en la consola (F12) lo que bloquearía.
# Cuando no aparezcan avisos al usar la app completa, cambia "Content-Security-Policy-Report-Only" por "Content-Security-Policy".
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://dzpgfgozyqvobceupkcy.supabase.co wss://dzpgfgozyqvobceupkcy.supabase.co; worker-src 'self'; manifest-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

# Los archivos con nombre único se guardan un año; la página y el service worker se revisan siempre
# (así una versión nueva se publica sin pantallas en blanco).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
